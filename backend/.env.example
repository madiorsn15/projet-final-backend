PORT=5000
NODE_ENV=development

# MongoDB local :
# MONGO_URI=mongodb://localhost:27017/marketplace
# MongoDB Atlas (prod) :
MONGO_URI=mongodb+srv://madiorsn15_db_user:Madior2026@cluster0.0ovu6uy.mongodb.net/marketplace?appName=Cluster0

# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
