# ══════════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT — SunuMarché Backend
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer le fichier .env sur Git !
# ══════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB local :
MONGO_URI=mongodb://localhost:27017/marketplace
# MongoDB Atlas (prod) :
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/marketplace

# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGER_CETTE_VALEUR_MINIMUM_64_CARACTERES_ALEATOIRES

# URL du frontend (CORS)
CLIENT_URL=http://localhost:3000

# Configuration Email (Nodemailer)
# Provider options : ethereal (dev), resend, gmail, sendgrid
EMAIL_PROVIDER=ethereal

# Développement : utilise Ethereal (gratuit, pas de vrais emails)
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=

# Resend (recommandé pour production)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_XXXXXXXXXXXXXX
# EMAIL_FROM=SunuMarché <onboarding@resend.dev>

# Gmail (pour testing seulement)
# EMAIL_PROVIDER=gmail
# EMAIL_USER=ton-email@gmail.com
# EMAIL_PASS=ton-mot-de-passe-d-application
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
